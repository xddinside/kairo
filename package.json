{
  "name": "kairo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "PORTLESS_APP_PORT=4173 portless kairo vite dev --host 0.0.0.0",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "check": "bun run generate-routes && bun run typecheck",
    "build": "vite build",
    "preview": "portless kairo-preview vite preview"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.9.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@json-render/core": "0.19.0",
    "@json-render/react": "0.19.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.34",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.21",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "portless": "0.15.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
