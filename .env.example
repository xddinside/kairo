# Kairo production foundation
# Keep real values in the ignored .env.local file or the deployment provider.

# Runtime mode. Production requires every server-only value below.
KAIRO_ENV=local

# Public origin used by Clerk, CSRF checks, and canonical links.
KAIRO_ORIGIN=https://kairo.localhost

# Clerk (Google sign-in and email magic links)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in

# Neon Postgres: pooled URL for requests; direct URL for Drizzle migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=
DATABASE_RUNTIME_ROLE=kairo_runtime
DATABASE_MIGRATION_ROLE=kairo_migrator

# Filebase S3-compatible private storage
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
FILE_STORAGE_SIGNING_SECRET=

# Sentry browser/server monitoring
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Scheduled work protection (set in Vercel and local test runs)
CRON_SECRET=

# Preview checks use one isolated Neon branch and one isolated private bucket.
# These are contracts for preview deployments, not production fallbacks.
KAIRO_PREVIEW_ID=
PREVIEW_DATABASE_URL=
PREVIEW_STORAGE_ENDPOINT=
PREVIEW_STORAGE_BUCKET=
KAIRO_PRODUCTION_ORIGIN=
KAIRO_PRODUCTION_DATABASE_URL=
KAIRO_PRODUCTION_STORAGE_BUCKET=

# Do not add the OpenCode Go credential here. It is intentionally human-owned.
