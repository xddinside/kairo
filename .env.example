# Kairo production foundation
# Keep real values in the ignored .env.local file or the deployment provider.

# Public origin used by Clerk, CSRF checks, and canonical links.
KAIRO_ORIGIN=http://localhost:4173

# Clerk (Google sign-in and email magic links)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres: pooled URL for requests; direct URL for Drizzle migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Filebase S3-compatible private storage
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
FILE_STORAGE_SIGNING_SECRET=

# Sentry browser/server monitoring
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Scheduled work protection (set in Vercel and local test runs)
CRON_SECRET=

# Do not add the OpenCode Go credential here. It is intentionally human-owned.
